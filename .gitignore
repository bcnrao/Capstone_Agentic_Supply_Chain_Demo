# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/

# Environment / secrets
.env

# Local databases / data artifacts
*.sqlite
*.sqlite3
*.db

# Postgres backup snapshots (keep the directory, ignore the dumps)
/data/backups/*
!/data/backups/.gitkeep

# Ingestion raw-pull snapshots (keep the directory, ignore the live pulls)
/data/snapshots/*
!/data/snapshots/.gitkeep

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter (notebooks are committed; checkpoints are not)
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Misc
docs

# Planning/spec docs kept local, not checked in
/specs/