# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# Groq API key. If unset (or empty), the LLM wrapper returns a deterministic
# mock response so the scaffold runs fully offline.
GROQ_API_KEY=

# Large reasoning/generation model used by the LLM wrapper — Groq GPT-OSS-120B
# (default: openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# Force the deterministic mock LLM even when an API key is present.
# Accepts 1/true. Default: false.
USE_MOCK_LLM=false

# --- Dev Postgres (Phase 0.5) -------------------------------------------------
# Used both by the Docker Compose `postgres` service (POSTGRES_DB/USER/PASSWORD)
# and by the app, which connects over DATABASE_URL. With no database reachable
# the connectivity helper degrades gracefully and the app still runs offline.

# Database name, user, and password for the local dev Postgres.
POSTGRES_DB=agentic_scd
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic

# Host/port the app connects to. The Compose service publishes 5432 on the host,
# so localhost:5432 reaches the container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string the app uses. If set, it wins over the POSTGRES_* parts
# above; otherwise it is assembled from them. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://agentic:agentic@localhost:5432/agentic_scd

# --- Always-on ingestion service (Phase 1b) ----------------------------------
# The `agentic-scd-ingest` service runs a FastAPI webhook plus an in-process
# APScheduler poller. All optional — sensible defaults below.

# Minutes between scheduled poll cycles (the poller runs every enabled connector
# through the pipeline). Default: 10.
INGEST_POLL_INTERVAL_MINUTES=10

# Set false to start the service with the webhook only (no scheduled poller).
# Accepts 1/true. Default: true.
INGEST_SCHEDULER_ENABLED=true

# Host/port the FastAPI ingestion service binds to. Default: 127.0.0.1:8001.
INGEST_HOST=127.0.0.1
INGEST_PORT=8001

# Reliability prior (0-1) stamped on signals pushed via the supplier webhook.
# Default: 0.6.
WEBHOOK_SOURCE_RELIABILITY=0.6

# --- Batch loaders & retention (Phase 1c) ------------------------------------
# The on-demand `agentic-scd-batch` CLI seeds historical data from committed
# `data/seed/` snapshots and prunes stale rows. All optional — defaults below.

# Set false to skip the batch loaders. Accepts 1/true. Default: true.
BATCH_ENABLED=true

# Set false to skip TTL retention pruning. Accepts 1/true. Default: true.
RETENTION_ENABLED=true

# Delete seen_rejected hashes older than this many days. Default: 30.
RETENTION_REJECTED_TTL_DAYS=30

# Delete terminal (status='done') signals older than this many days. Default: 90.
RETENTION_SIGNALS_TTL_DAYS=90
