# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# Groq API key. If unset (or empty), the LLM wrapper returns a deterministic
# mock response so the scaffold runs fully offline.
GROQ_API_KEY=

# Large reasoning/generation model used by the LLM wrapper — Groq GPT-OSS-120B
# (default: openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# Force the deterministic mock LLM even when an API key is present.
# Accepts 1/true. Default: false.
USE_MOCK_LLM=false

# --- Dev Postgres (Phase 0.5) -------------------------------------------------
# Used both by the Docker Compose `postgres` service (POSTGRES_DB/USER/PASSWORD)
# and by the app, which connects over DATABASE_URL. With no database reachable
# the connectivity helper degrades gracefully and the app still runs offline.

# Database name, user, and password for the local dev Postgres.
POSTGRES_DB=agentic_scd
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic

# Host/port the app connects to. The Compose service publishes 5432 on the host,
# so localhost:5432 reaches the container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string the app uses. If set, it wins over the POSTGRES_* parts
# above; otherwise it is assembled from them. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://agentic:agentic@localhost:5432/agentic_scd
